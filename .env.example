# ChainRelay environment configuration example.
# Copy this file to .env and fill in values as needed.
# Never commit a real .env file — it is excluded by .gitignore.

# Portaldot WebSocket endpoint (read-only connection target)
PORTALDOT_WS_URL=wss://mainnet.portaldot.io

# Optional: override the default token decimals for POT (14)
POT_DECIMALS=14